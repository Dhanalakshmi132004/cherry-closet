datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         String    @default("customer") // "customer" | "admin"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  orders       Order[]
}

model Address {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  orders     Order[]
}

model Product {
  id                String         @id @default(uuid())
  slug              String         @unique
  title             String
  description       String
  materials         String?
  dimensions        String?        // physical sizing
  basePrice         Float
  compareAtPrice    Float?         // for sales
  madeToOrder       Boolean        @default(false)
  shipEstimateDays  Int            @default(3)
  collectionId      String?
  collection        Collection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  variants          Variant[]
  published         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orderItems        OrderItem[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  altText   String?
}

model Variant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String?
  size          String?
  stock         Int         @default(0)
  priceOverride Float?
  sku           String?     @unique
  orderItems    OrderItem[]
}

model Collection {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Order {
  id            String      @id @default(uuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        String      @default("pending") // "pending" | "in_production" | "shipped" | "delivered"
  subtotal      Float
  shippingCost  Float       @default(0)
  total         Float
  addressId     String?
  address       Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customerEmail String?     // For guest checkout
  customerName  String?     // For guest checkout
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity        Int
  priceAtPurchase Float
}
